{
    "replace": true,
    "multipart": [
        {
            "when": {
                "down": "true"
            },
            "apply": {
                "model": "estfc:block/snowy/tfc/plant/moss"
            }
        },
        {
            "when": {
                "east": "true"
            },
            "apply": {
                "model": "estfc:block/snowy/tfc/plant/moss",
                "x": 270,
                "y": 90
            }
        },
        {
            "when": {
                "north": "true"
            },
            "apply": {
                "model": "estfc:block/snowy/tfc/plant/moss",
                "x": 270
            }
        },
        {
            "when": {
                "south": "true"
            },
            "apply": {
                "model": "estfc:block/snowy/tfc/plant/moss",
                "x": 270,
                "y": 180
            }
        },
        {
            "when": {
                "up": "true"
            },
            "apply": {
                "model": "estfc:block/snowy/tfc/plant/moss_hanging"
            }
        },
        {
            "when": {
                "west": "true"
            },
            "apply": {
                "model": "estfc:block/snowy/tfc/plant/moss",
                "x": 270,
                "y": 270
            }
        }
    ]
}